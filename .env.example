# ============================================================================
# KRIPTOQUANT — Canlı Borsa & Ortam Yapılandırması
# ============================================================================

# Binance API Anahtarları
BINANCE_API_KEY=
BINANCE_SECRET=

# Testnet Modu (true = Binance Futures Testnet / Sanal USDT, false = Gerçek Borsa)
BINANCE_USE_TESTNET=true

# Canlı Emir Gönderimi (true = Canlı emir ilet, false = Kuru Sıkı / Dry-Run)
LIVE_TRADING_ENABLED=false

# Risk Yönetimi Parametreleri
MAX_TRADE_SIZE_USD=20          # İşlem başına maksimum sermaye ($)
MAX_DAILY_LOSS_USD=10          # Günlük toplam zarar limiti ($) — Aşılırsa Kill Switch kilitler
MAX_OPEN_TRADES=3              # Canlıda aynı anda açık kalabilecek maksimum işlem sayısı
LEVERAGE=1                     # Kaldıraç oranı (1 = Spot eşdeğeri, risksiz)
MARGIN_MODE=ISOLATED           # Marjin Modu: ISOLATED (İzole) veya CROSSED (Çapraz)
